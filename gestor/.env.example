# Copiar como gestor/.env y cambiar los valores. El .env no se sube al repo.

# Cuenta del administrador para entrar al gestor
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Clave para firmar las sesiones. Generar una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Horas que dura una sesion antes de pedir login otra vez
TOKEN_HORAS=8
