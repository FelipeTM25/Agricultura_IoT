# Copiar como gestor/.env y cambiar los valores. El .env no se sube al repo.

# Cuenta del administrador para entrar al gestor
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Clave para firmar las sesiones. Generar una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Horas que dura una sesion antes de pedir login otra vez
TOKEN_HORAS=8

# Dispositivos que pueden enviar lecturas (POST /api/dispositivos/<id>/lecturas) y su clave,
# separados por coma: id:clave,id:clave. La misma clave va en DISPOSITIVO_CLAVE del firmware.
# Generar cada clave con:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DISPOSITIVOS=sensor01:cambia-esta-clave
# Tipo de entidad con el que se guardan en Orion
TIPO_DISPOSITIVO=SensorAgricola
