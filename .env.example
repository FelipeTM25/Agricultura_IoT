# Copiar como .env (en la raiz, junto a docker-compose.yml) y cambiar los valores.
# El .env no se sube al repo. Lo usan Postgres, el servicio de limpieza y Grafana.

POSTGRES_DB=agricultura
POSTGRES_USER=agricultura
# Generar una con: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Cada cuantos minutos se limpia sola (0 = solo con el boton del gestor)
LIMPIEZA_INTERVALO_MIN=15
# Tamano de los intervalos en los que se promedian los datos limpios
LIMPIEZA_INTERVALO_DATOS_MIN=5
