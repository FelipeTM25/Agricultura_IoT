# Copiar como .env (en la raiz, junto a docker-compose.yml) y cambiar los valores.
# El .env no se sube al repo. Lo usan Postgres, la limpieza, las alertas y Grafana.

POSTGRES_DB=agricultura
POSTGRES_USER=agricultura
# Generar una con: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Cada cuantos minutos se limpia sola (0 = solo con el boton del gestor)
LIMPIEZA_INTERVALO_MIN=15
# Tamano de los intervalos en los que se promedian los datos limpios
LIMPIEZA_INTERVALO_DATOS_MIN=5

# Alertas: lecturas seguidas que deben cumplir un umbral para avisar (el nodo envia cada 30 s)
ALERTAS_CONFIRMAR_LECTURAS=2
# Correo que envia las alertas (opcional: vacio = solo se ven en el gestor y la landing).
# Con Gmail: activar la verificacion en 2 pasos de la cuenta y crear una contrasena de aplicacion
# en https://myaccount.google.com/apppasswords. Esa (16 letras) va en SMTP_PASSWORD, no la normal.
SMTP_USUARIO=
SMTP_PASSWORD=
# A quien le llegan, separados por coma. Vacio = al mismo SMTP_USUARIO
ALERTAS_CORREO_DESTINO=
# Otro proveedor (Outlook: smtp.office365.com). Gmail es el valor por defecto
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
