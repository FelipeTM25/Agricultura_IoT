      "description": "Lecturas que la limpieza no paso a Postgres, agrupadas por la regla que las descarto.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres-limpios"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(hora, '1h'), regla AS metric, count(*) AS value FROM descartes WHERE sensor_id = '$sensor' AND $__timeFilter(hora) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
